<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fs_clock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextClock
            android:id="@+id/fs_clock_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="H:mm"
            android:textSize="34sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fullscreen_clock_widget_wide_label"
            android:textColor="#CCFFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Secondary target; opens the same immersive clock -->
    <TextView
        android:id="@+id/fs_clock_dim"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="64dp"
        android:text="@string/fullscreen_clock_widget_dim"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/widget_chip_bg"
        android:gravity="center"
        android:paddingLeft="8dp"
        android:paddingRight="8dp" />

</LinearLayout>
